 "sections": [
  {
   "bars": "0",
   "name": "Envelope: the seed",
   "intent": "Romantic anticipation. Solo bansuri states the five-note seed over a swarmandal strum and a whisper of strings; chimes on the seal and flaps."
  },
  {
   "bars": "1-2",
   "name": "Twilight garden: first sawal-jawab",
   "intent": "Violin answers the flute with the shuddha-Ma descent, left open on Re; flute replies with the seed in song rhythm. Piano 12/8 begins, santoor sparkles on the typed line, harp on the floral frame."
  },
  {
   "bars": "3-4",
   "name": "Groom",
   "intent": "Flute leads: Pa Dha Ni rising to tar Sa exactly on his name (11.0) with celesta; tabla enters in a soft dadra."
  },
  {
   "bars": "5-6",
   "name": "Bride",
   "intent": "Violin leads in a tender Pahadi pentatonic, blooming on Dha at her name (17.0); santoor ostinato replaces piano; flute answers with Pa Ni Re."
  },
  {
   "bars": "7-9",
   "name": "Couple: the mukhda",
   "intent": "Emotional heart. The full mukhda over the descending bass C-B-A-G-F-E-D-G; violin echoes then sings in thirds; richer strings. Curtains: bVI hush (28.5), bVII lift (29.25) with tabla roll."
  },
  {
   "bars": "10-12",
   "name": "Reception stage: the bloom",
   "intent": "Grand but controlled: flute, solo violin and the violin section sing the mukhda together over full chords, harp cascade, santoor tremolo; peak on tar Sa at 33.75 (0 dB); closing line 2 lands on Sa as the card rises."
  },
  {
   "bars": "13-16",
   "name": "Invitation card: reduction",
   "intent": "Readable: piano lilt, light strings, soft tabla. A sitar phrase after the cadence, the mukhda at half speed on flute over D/F#, small violin echoes; sparkles on RECEPTION and the date."
  },
  {
   "bars": "17-19",
   "name": "Finale and signature",
   "intent": "The mukhda returns as a duet in thirds; Sa' blooms with the signature (55.0), held over bVI, then bVII to the final C6/9 at 57.0 with kan on Sa, santoor run and swarmandal strum; tabla tihai lands on sam."
  }
 ],
