 "sections": [
  {
   "bars": "0",
   "name": "Envelope - alap",
   "intent": "Romantic anticipation: bansuri alap A4-D5-E5-F#5 over santoor tremolo and a pp pad; harp glissando as the seal flies, violin pickup as the flaps open."
  },
  {
   "bars": "1-2",
   "name": "Twilight garden - the theme is introduced",
   "intent": "Solo violin sings T1 over the warm 12/8 piano pulse (D - Bm7), then leaves the phrase open on E5 (Gmaj7 - A7sus4 - A7); sitar answer, bloom on the A7 resolution at 8.25."
  },
  {
   "bars": "3-4",
   "name": "Groom",
   "intent": "Bansuri phrase in the theme rhythm, meend into B5 exactly on his name (11.0) on a pushed Em9; violin answers rising into F#7/A#. Bass and light tabla enter."
  },
  {
   "bars": "5-6",
   "name": "Bride",
   "intent": "Violin mirror phrase, higher and sweeter, meend to C#6 on her name (17.0) over A(add9); circle-of-fifths F#m7 - Bm7 - Em9 - A7sus4 pulls toward home."
  },
  {
   "bars": "7-9",
   "name": "The couple - the mukhda arrives",
   "intent": "The emotional heart: violin T1 lands with the couple at 21.0, the bansuri answers with the komal-Ni sigh (T2), both climb T3 in thirds to B5/G5 as the curtains close; richer strings, dadra tabla, warm bass; the cadence is withheld."
  },
  {
   "bars": "10-12",
   "name": "Reception stage - grand bloom",
   "intent": "The string section sweeps the full mukhda in octaves over a descending bass D-C#-B-A, bansuri descant a third above (C#6 under the names at 32.0), joining the tutti T3 climb to B5; bells, santoor, harp, fuller but round tabla."
  },
  {
   "bars": "13-16",
   "name": "Invitation card - elegant reduction and lift",
   "intent": "The withheld cadence (T4) resolves on solo violin as the card settles; piano B-minor echo of T1, sitar answer, bansuri echo of the garden phrase; light pad and tabla keep it readable; bar 16 lifts G - A - B7 into the new key."
  },
  {
   "bars": "17-19",
   "name": "Finale in E major",
   "intent": "The bansuri takes the mukhda up a whole step, reaches C#6 under the signature, the tabla tihai lands on sam at 57.0; final E(add9) with bansuri murki, santoor flourish and tremolo, harp roll, music box; fades 58.0-59.2."
  }
 ],
